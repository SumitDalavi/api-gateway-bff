# .env.example — api-gateway-bff
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── Redis / Shared Cache ───────────────────────────────────────────────────
# UNSET (default): In-process Map() cache with TTL (zero external dependencies)
# SET to redis URL: Managed Redis cluster (e.g., redis://localhost:6379 or rediss://...)
REDIS_URL=

# ── Service Dependencies ───────────────────────────────────────────────────
JWT_SECRET=bff-super-secret
USER_SERVICE_URL=http://user-service:3001
ORDER_SERVICE_URL=http://order-service:3002
DASHBOARD_CACHE_TTL_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# ── Configuration Hot-Reload ───────────────────────────────────────────────
# UNSET (default): Boot-time static config
# SET to mount directory (Kubernetes ConfigMap): Dynamic hot-reload without restart
CONFIG_MOUNT_PATH=

# ── Server Port ───────────────────────────────────────────────────────────
PORT=3000
